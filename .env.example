# Public URL. Use your Railway-generated domain in production.
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Generate both with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-value
APP_ENCRYPTION_KEY=replace-with-a-different-long-random-value

# Add a PostgreSQL service on Railway; DATABASE_URL is injected automatically.
DATABASE_URL=

# Google Cloud OAuth 2.0 Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI is optional. Choose: rules, openai, anthropic, or openai-compatible.
# "rules" never sends content to an AI provider.
AI_PROVIDER=rules
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_INPUT_CHARS_PER_ITEM=1800

# Privacy and retention. Raw email bodies are never persisted.
SIGNAL_RETENTION_DAYS=30
SYNC_LOOKBACK_DAYS=7
SYNC_MAX_MESSAGES=35

# Every 30 minutes. Uses standard five-field cron syntax.
SYNC_CRON=*/30 * * * *

# Sample data is strictly opt-in and visibly labeled. Production should stay false.
DEMO_MODE=false
