# Public URL. Use your Railway-generated domain in production.
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Generate both with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-value
APP_ENCRYPTION_KEY=replace-with-a-different-long-random-value

# Add a PostgreSQL service on Railway; DATABASE_URL is injected automatically.
DATABASE_URL=
# TLS to Postgres: automatic (on for managed hosts, off for a local/compose database). Set true or false to force it.
# DATABASE_SSL=

# Google Cloud OAuth 2.0 Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single-tenant access control. Only this Google account may enter the instance.
OWNER_EMAIL=you@example.com

# AI is optional. Choose: rules, openai, anthropic, or openai-compatible.
# "rules" never sends content to an AI provider.
AI_PROVIDER=rules
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_INPUT_CHARS_PER_ITEM=1800

# Privacy and retention. Raw email bodies are never persisted.
SIGNAL_RETENTION_DAYS=30
SYNC_LOOKBACK_DAYS=7
SYNC_MAX_MESSAGES=35
INITIAL_SYNC_LOOKBACK_DAYS=30
INITIAL_SYNC_MAX_MESSAGES=100

# Scheduler wake-up. Per-owner enable/disable and intervals are configured in Settings.
# Keep this at or below the shortest selectable interval. Uses five-field cron syntax.
SYNC_CRON=*/5 * * * *

# Sample data is strictly opt-in and visibly labeled. Production should stay false.
DEMO_MODE=false

# ── Agent (installation ceilings; the in-app settings can only be stricter) ──
AGENT_ENABLED=true
AGENT_MAX_STEPS=12
AGENT_MAX_RUNS_PER_DAY=50
# required = ask before every change. external = ask only before changing outside services.
ACTION_APPROVAL_DEFAULT=required
EXTERNAL_WRITES_ENABLED=true
# Orbit has no send tool. This flag only reserves the policy slot; leave false.
EMAIL_SENDING_ENABLED=false
SKILLS_ENABLED=false
MCP_ENABLED=false
AUTOMATIONS_ENABLED=true
MEMORY_ENABLED=true
MEMORY_RETENTION_DAYS=365
RUN_RETENTION_DAYS=90

# ── Delivery channels (optional) ──
# SMTP_URL=smtps://user:pass@smtp.example.com
# DIGEST_FROM=orbit@example.com
# DIGEST_TO=you@example.com
# TELEGRAM_BOT_TOKEN=
# Dev/test only. Lets skills reach loopback addresses. NEVER enable on a hosted install.
# SKILLS_ALLOW_PRIVATE_NETWORK=false

# ── Pacts, Telegram chat and Orbit-to-Orbit sharing ──
# Pacts: private links the other person opens without an account. On by default.
PACTS_ENABLED=true
# Days a pact link keeps working before it expires.
PACT_LINK_TTL_DAYS=45
# Most open pacts at once (also caps what any one peer can push to you).
PACT_MAX_OPEN=500
# Chat with Orbit on Telegram (needs TELEGRAM_BOT_TOKEN above). Link your chat from Connections.
TELEGRAM_INBOUND_ENABLED=true
# Orbit-to-Orbit sharing exposes two public endpoints, so it is off until you opt in.
# It also needs OWNER_EMAIL and an https APP_URL.
FEDERATION_ENABLED=false
# Where the "run your own" link on pact pages points.
# ORBIT_REPO_URL=https://github.com/advaidg/orbit-personal-cockpit

# VPS install only (docker-compose.vps.yml)
# DOMAIN=orbit.example.com
# POSTGRES_PASSWORD=
