{
  "name": "orbit-personal-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source personal operations cockpit that turns your connected services into a focused daily brief.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@vitejs/plugin-react": "latest",
    "cookie-parser": "latest",
    "date-fns": "latest",
    "dotenv": "latest",
    "express": "latest",
    "googleapis": "latest",
    "helmet": "latest",
    "lucide-react": "latest",
    "node-cron": "latest",
    "openai": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
