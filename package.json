{
  "name": "orbit-personal-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source personal operations cockpit that turns your connected services into a focused daily brief.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "chatgpt:connect": "tsx scripts/chatgpt-connect.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:pg": "DATABASE_URL=postgres://orbit:orbit@localhost:54329/orbit_test vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vitejs/plugin-react": "latest",
    "cookie-parser": "latest",
    "date-fns": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "googleapis": "latest",
    "helmet": "latest",
    "jose": "^6.2.12",
    "lucide-react": "latest",
    "node-cron": "latest",
    "nodemailer": "^10.1.2",
    "openai": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "undici": "^7.30.1",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "open": "^11.0.4",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
